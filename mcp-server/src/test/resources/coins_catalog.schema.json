{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/scraper/coins_catalog.schema.json",
  "title": "Coin catalog scrape result",
  "description": "Выходной JSON скрейперов каталогов монет (эталон: coin-catalog-lanta)",
  "type": "object",
  "required": ["scrapedAt", "scrapeStatus", "totalPages", "totalCoins", "coins"],
  "additionalProperties": false,
  "properties": {
    "scrapedAt": {
      "type": "string",
      "description": "Время начала сбора (ISO 8601)"
    },
    "scrapeStatus": {
      "type": "string",
      "enum": ["ok", "captcha_blocked", "error"]
    },
    "totalPages": {
      "type": "integer",
      "minimum": 0
    },
    "totalCoins": {
      "type": "integer",
      "minimum": 0
    },
    "coins": {
      "type": "array",
      "items": { "$ref": "#/$defs/coin" }
    },
    "query": {
      "type": "string",
      "minLength": 1,
      "description": "Присутствует только при непустом --query"
    },
    "investmentOnly": {
      "type": "boolean",
      "const": true,
      "description": "Присутствует только при --investment-only"
    },
    "error": {
      "type": "string",
      "description": "Текст ошибки при scrapeStatus != ok"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "scrapeStatus": { "const": "ok" } },
        "required": ["scrapeStatus"]
      },
      "then": {}
    },
    {
      "if": {
        "properties": { "scrapeStatus": { "enum": ["captcha_blocked", "error"] } },
        "required": ["scrapeStatus"]
      },
      "then": { "required": ["error"] }
    }
  ],
  "$defs": {
    "coin": {
      "type": "object",
      "required": [
        "catalogNumber",
        "name",
        "metal",
        "weightG",
        "sellPrice"
      ],
      "additionalProperties": false,
      "properties": {
        "catalogNumber": {
          "type": ["string", "null"]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "metal": {
          "type": ["string", "null"],
          "description": "Только название металла, без пробы"
        },
        "weightG": {
          "type": ["number", "null"]
        },
        "buyPrice": {
          "type": ["number", "null"]
        },
        "sellPrice": {
          "type": ["number", "null"]
        }
      }
    }
  }
}
